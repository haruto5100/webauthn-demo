# =========================
# Python / FastAPI
# =========================
# コンパイル済みファイルやキャッシュ（これらを含めるとリポジトリが重くなります）
__pycache__/
*.py[cod]
*$py.class

# 仮想環境（各開発者のPCで作成すべきものなのでGitには含めません）
venv/
env/
.env/

# パッケージ等のメタデータ
*.egg-info/
.eggs/

# =========================
# 環境変数・シークレット
# =========================
# 鍵情報やAPIキーなどを書いたファイル（今回は使っていなくても今後の事故防止として必須）
.env
*.pem
*.key

# =========================
# OS固有のファイル (macOS)
# =========================
# Macが勝手に作る隠しファイル
.DS_Store
.AppleDouble
.LSOverride

# =========================
# エディタ・IDE固有のファイル
# =========================
# VS Codeの設定ファイル（個人設定を他人に強制させないため）
.vscode/

# その他エディタのキャッシュ等
.idea/
*.swp